{
	"$schema": "https://app.kilo.ai/config.json",
	"snapshot": true,
	"watcher": {
		"ignore": [
			"tmp/**",
			"logs/**",
			"node_modules/**",
			".build/**",
			"dist/**",
			".git/**"
		]
	},
	"mcp": {
		"codebase-memory-mcp": {
			"type": "local",
			"command": ["/home/agent_880f91cb-9038-4b40-bd29-e783b55c21bf/.local/bin/codebase-memory-mcp"],
			"args": [],
			"enabled": true
		}
	},
	"permission": {
		"grep *": "deny",
		"glob *": "deny",
		"find *": "deny",
		"codebase-memory-mcp_*": "allow",
		"read": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny",
			"*.env.example": "allow"
		},
		"bash": {
			"*": "ask",
			"git *": "allow",
			"git commit *": "allow",
			"git push *": "ask",
			"grep *": "deny",
			"glob *": "deny",
			"uv *": "allow",
			"conda *": "deny",
			"pip *": "deny",
			"code *": "deny",
			"head *": "allow",
			"tail *": "allow",
			"wc *": "allow",
			"python -m py_compile *": "allow",
			"ls *": "allow",
			"echo *": "allow",
			"npm *": "allow",
			"pnpm *": "allow",
			"find *": "deny"
		},
		"write": "allow",
		"edit": "allow",
		"webfetch": "allow",
		"websearch": "allow",
		"skill": "allow",
		"todoread": "allow",
		"todowrite": "allow",
		"question": "allow",
		"task": "allow",
		"lsp": "allow"
	}
}
