{
	"$schema": "https://app.kilo.ai/config.json",
	"snapshot": true,
	"watcher": {
		"ignore": [
			"tmp/**",
			"logs/**",
			"node_modules/**",
			".build/**",
			"dist/**",
			".git/**"
		]
	},
	"mcp": {
		"sequential-thinking": {
			"type": "local",
			"enabled": true,
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-sequential-thinking"
			]
		},
		"codebase-memory-mcp": {
			"type": "local",
			"enabled": true,
			"command": "codebase-memory-mcp",
			"args": []
		}
	},
	"permission": {
		"grep *": "deny",
		"glob *": "deny",
		"find *": "deny",
		"read": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny",
			"*.env.example": "allow"
		},
		"bash": {
			"*": "ask",
			"git *": "allow",
			"git commit *": "allow",
			"git push *": "ask",
			"grep *": "deny",
			"glob *": "deny",
			"uv *": "allow",
			"conda *": "deny",
			"pip *": "deny",
			"code *": "deny",
			"head *": "allow",
			"tail *": "allow",
			"wc *": "allow",
			"python -m py_compile *": "allow",
			"ls *": "allow",
			"echo *": "allow",
			"npm *": "allow",
			"pnpm *": "allow",
			"find *": "deny"
		},
		"write": "allow",
		"edit": "allow",
		"webfetch": "allow",
		"websearch": "allow",
		"skill": "allow",
		"todoread": "allow",
		"todowrite": "allow",
		"question": "allow",
		"task": "allow",
		"lsp": "allow"
	}
}
