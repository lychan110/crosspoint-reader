#!/usr/bin/env bash
# Install the local git hooks shipped in bin/.
# Run this after cloning the fork.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

for hook in bin/pre-push-guard; do
  name="$(basename "$hook" -guard)"
  if [ "$name" = "pre-push" ]; then
    target=".git/hooks/pre-push"
  else
    target=".git/hooks/$name"
  fi
  cp "$hook" "$target"
  chmod +x "$target"
  echo "installed $target from $hook"
done

echo ""
echo "Hooks installed. To verify:"
echo "  ls -la .git/hooks/pre-push"
echo ""
echo "To test the develop-push guard without actually pushing:"
echo "  git push --dry-run origin develop   # should be blocked unless local develop == upstream/develop"
